{
  "name": "codemitvishal-portfolio",
  "version": "2.0.0",
  "private": true,
  "description": "Portfolio of Vishal Singh: Cloud Engineer (Azure & Kubernetes, DevSecOps, Agentic AI)",
  "author": "Vishal Singh",
  "homepage": "https://codemitvishal.github.io/",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && gh-pages -d dist -b gh-pages -m \"Deploy portfolio\"",
    "assistant:dev": "npx wrangler@4 dev --config worker/wrangler.toml --remote",
    "assistant:deploy": "npx wrangler@4 deploy --config worker/wrangler.toml",
    "check:secrets": "node scripts/check-secrets.mjs --all",
    "prepare": "git config core.hooksPath .githooks || true"
  },
